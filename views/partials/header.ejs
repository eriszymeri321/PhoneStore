<!doctype html>
<html lang="sq">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Phone Store</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-ENjdO4Dr2bkBIFxQpeoYz1FQ7757q2Qe1rZ+3mZQZ6V9zzTtmI3UksdQRVvoxMfoo"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container-fluid px-0">
        <div class="header-inner">
          <a class="brand-mark" href="/" aria-label="Phone Store, faqja kryesore"><span class="brand-mark__icon">P</span><span>phone<span>store</span><small>TECH THAT MOVES YOU</small></span></a>
          <nav class="category-nav" aria-label="Kategoritë">
            <div class="nav-items">
              <a href="/" class="nav-link">Dyqani</a>
              <% if (currentUser && currentUser.role === 'admin') { %><a href="/admin/orders" class="nav-link">Porositë</a><a href="/phones/create" class="nav-link">Shto produkt</a><% } %>
            </div>
          </nav>

          <div class="header-utilities">
            <form method="get" action="/" class="header-search" role="search">
              <input
                type="search"
                name="search"
                class="header-search__input"
                value="<%= typeof search !== 'undefined' ? search : '' %>"
                placeholder="Kërko..."
                aria-label="Kërko telefona"
              />
              <button type="submit" class="utility-btn" aria-label="Kërko">
                <span class="utility-icon" aria-hidden="true">&#128269;</span>
                <span class="utility-label">Search</span>
              </button>
            </form>
            <a href="/cart" class="utility-btn">
              <span class="utility-icon" aria-hidden="true">&#128722;</span>
              <span class="utility-label">Shporta (<span data-cart-count>0</span>)</span>
            </a>
            <% if (currentUser) { %>
              <span class="utility-label user-greeting">Përshëndetje, <%= currentUser.name %></span>
              <form method="post" action="/logout" class="logout-form"><button class="utility-btn" type="submit">Dil</button></form>
            <% } else { %>
              <a href="/login" class="utility-btn"><span class="utility-label">Hyr</span></a>
              <a href="/register" class="utility-btn"><span class="utility-label">Regjistrohu</span></a>
            <% } %>
          </div>
        </div>
      </div>
    </header>

    <main class="site-main">
      <div class="container page-shell">
